# LiveStream API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# SQLite database file (relative to repo root or absolute)
DATABASE_PATH=./data/livestream.db

# Media directories (relative to repo root)
MEDIA_ROOT=./media
UPLOADS_DIR=./media/uploads
HLS_DIR=./media/hls

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS (web origin)
CORS_ORIGIN=http://localhost:5173

# Trust X-Forwarded-* (enable behind Caddy / Cloudflare in production)
TRUST_PROXY=false

# Seed admin
SEED_ADMIN_EMAIL=admin@livestream.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
SEED_EDITOR_EMAIL=editor@livestream.local
SEED_EDITOR_PASSWORD=editor123
SEED_EDITOR_NAME=Editor

# ffmpeg / ffprobe (leave empty to use PATH, then npm installer packages)
FFMPEG_PATH=
FFPROBE_PATH=

# Optional AV1/VP9 rung beside H.264 (slow; default off)
ENABLE_AV1_LADDER=0

# Cap ABR ladder (720 = no 1080). Default 1080
# MAX_ENCODE_HEIGHT=1080

# 0 = queue only; run `npm run worker -w server` separately
# ENCODE_IN_PROCESS=1

# Do not enable with Cloudflare shared cache unless cache key designed
# SIGNED_MEDIA=0

# ——— Optional third-party (production; see docs/SUPABASE.md, deploy.md) ———
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_POSTERS_BUCKET=posters
# DATABASE_URL=
# SENTRY_DSN=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_PUBLISH_MODE=off
