# Copy to `.env.production` and fill in before `docker compose up`.
# NEVER commit real secrets.

# ——— Domain / public URL ———
DOMAIN=livestream.example.com
CORS_ORIGIN=https://livestream.example.com

# ——— JWT (required — generate long random strings) ———
JWT_ACCESS_SECRET=change-me-access-production-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-refresh-production-use-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ——— Cookies (HTTPS behind Caddy / Cloudflare) ———
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ——— Trust reverse proxy (Caddy / Cloudflare) for req.ip ———
TRUST_PROXY=true

# ——— Seed admin (applied only when DB has zero users) ———
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Admin
SEED_EDITOR_EMAIL=editor@example.com
SEED_EDITOR_PASSWORD=change-me-editor-password
SEED_EDITOR_NAME=Editor

# ——— Optional: system ffmpeg already set in image; override if needed ———
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
ENABLE_AV1_LADDER=0

# Cap ABR ladder height (720 = drop 1080 rung). Default 1080.
# MAX_ENCODE_HEIGHT=1080

# Encode in API process (1) or queue for worker profile (0). See docs/ENCODE_OFFPEAK.md
# ENCODE_IN_PROCESS=1

# NEVER enable with Cloudflare HLS cache (breaks cache key) unless cache key designed
# SIGNED_MEDIA=0

# ——— Supabase (optional — posters to Storage when both set) ———
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_POSTERS_BUCKET=posters
# DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres
#   ↑ Phase B — not used by default (SQLite). See docs/SUPABASE.md

# ——— Cloudflare (documentation / future rate-limit; proxy handles TLS) ———
# CF_ZONE_ID=
# CF_API_TOKEN=

# ——— Sentry (optional — wire later; DSN stub only) ———
# SENTRY_DSN=https://...@o....ingest.sentry.io/...

# ——— Email (future — Resend or SMTP) ———
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@livestream.example.com

# ——— Cloudflare R2 (optional HLS object storage) ———
# When all R2_* set + R2_PUBLISH_MODE=hot|all, encode publishes HLS and playbackUrl uses public URL.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=livestream-hls
# R2_PUBLIC_BASE_URL=https://media.livestream.example.com
# MEDIA_ORIGIN=https://media.livestream.example.com
#   ↑ alias for R2_PUBLIC_BASE_URL if unset
# R2_PUBLISH_MODE=off
#   off = local only | hot = series.isHot | all = every encode (Phase 2 default)