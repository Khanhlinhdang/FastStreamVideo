# Minimal env for docker-compose.ci.yml (committed — not real secrets)
DOMAIN=localhost
CORS_ORIGIN=http://localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=true
JWT_ACCESS_SECRET=ci-access-secret-not-for-production-32b
JWT_REFRESH_SECRET=ci-refresh-secret-not-for-production-32b
SEED_ADMIN_EMAIL=admin@livestream.local
SEED_ADMIN_PASSWORD=ci-admin-pass-change-me
SEED_ADMIN_NAME=Admin
SEED_EDITOR_EMAIL=editor@livestream.local
SEED_EDITOR_PASSWORD=ci-editor-pass-change-me
ENABLE_AV1_LADDER=0
SIGNED_MEDIA=0
