# LiveStream reverse proxy
# DOMAIN comes from compose env (e.g. livestream.example.com)
#
# TLS:
# - Default: Caddy automatic HTTPS (Let's Encrypt) — pair with Cloudflare SSL mode Full (strict)
# - Origin certificate alternative: see docs/CLOUDFLARE.md
# - Local: DOMAIN=localhost (Caddy serves HTTP on :80)

{$DOMAIN:localhost} {
	encode gzip

	# API
	handle /api/* {
		reverse_proxy api:4000
	}

	# HLS served from disk volume (bypass Node for segments) — AUD-019
	# Volume mount: livestream_media → /srv (so /srv/hls/... maps to media/hls)
	handle_path /media/hls/* {
		root * /srv/hls
		header Cache-Control "public, max-age=60"
		@segments path *.m4s *.mp4
		header @segments Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Other media (posters, subs, uploads) via API static
	handle /media/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	# Frontend static (nginx in web container)
	handle {
		reverse_proxy web:80
	}
}
